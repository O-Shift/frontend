# oshift/.env.example
# Copy this file to .env.local in the oshift directory:
#   cp .env.example .env.local

# Supabase Credentials (Project URL and Anon/Public Key from Supabase Dashboard)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Canonical origin used to resolve relative URLs in page metadata (see
# metadataBase in src/app/layout.tsx). Leave unset locally; production must point
# at the stable public origin so og:image resolves for social crawlers.
NEXT_PUBLIC_SITE_URL=https://www.orangeshift.net

# Both domains attach to the same Vercel project; proxy.ts separates surfaces.
# Production: configure this before switching traffic. Preview/local can leave
# these unset to keep auth/product paths on their own host for testing.
NEXT_PUBLIC_APP_URL=https://app.orangeshift.net

# FastAPI Backend Base URL (Local Dev — proxied via /api to avoid CORS)
NEXT_PUBLIC_API_BASE_URL=/api
API_BACKEND_URL=http://localhost:8000

# PostHog Analytics (Project API Key from Project Settings)
# Analytics no-ops entirely when the key is unset, so leave it blank for local
# work you do not want in the dashboards. Capture is proxied through /ingest
# (see next.config.ts), so the host below is only used to build links back to
# PostHog's own UI — it must still match the region your project lives in.
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-project-key-here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
